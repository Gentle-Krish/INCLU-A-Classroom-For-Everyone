<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <capability
        android:name="custom.actions.intent.JOIN_CLASS"
        app:queryPatterns="@array/join_class_queries">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="app.chalk.chalk_student"
            android:targetClass="app.chalk.chalk_student.MainActivity">
            <url-template android:value="chalk://join?room={code}" />
            <parameter
                android:name="code"
                android:key="code"
                android:mimeType="https://schema.org/Text" />
        </intent>
    </capability>
</shortcuts>
